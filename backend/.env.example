# FeaturePlus Environment Configuration
# Copy this file to .env and fill in what you use. Never commit the real .env.

# ---------- Server ----------

# Where to listen. 0.0.0.0:8080 is the default; behind a reverse proxy on the
# same machine, 127.0.0.1:8080 keeps the port off the public interface.
# FP_ADDR=0.0.0.0:8080

# Path to data directory (templates.json and guidance.json)
DATA_PATH=./data

# The SQLite database. Defaults to test.db in the data directory.
# FP_DB_PATH=/srv/featureplus/featureplus.db

# Mark the sign-in cookie Secure. Set automatically when the request arrives
# over HTTPS or the proxy sends X-Forwarded-Proto: https; force it here if
# your proxy does not send that header.
# FP_SECURE_COOKIES=true

# ---------- AI (Playground "Ask AI") ----------

# With a key, the Playground drafts with Claude; without one, a stand-in
# answers. Restart the server after setting it.
# ANTHROPIC_API_KEY=

# The model to draft with. Defaults to claude-opus-5-5.
# FP_AI_MODEL=claude-opus-5-5

# ---------- GitHub publishing (GitHub App) ----------

# From the GitHub App's settings page. Each person signs in with their own
# GitHub account; these only identify the app. The callback URL registered on
# the app must be https://<your domain>/api/v1/github/callback.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------- Older integrations ----------

# Personal token for the older GitHub MCP integration. Optional: without it
# that integration stays off. Set FP_REQUIRE_GITHUB_TOKEN=true to make a
# missing token stop the server from starting.
# GITHUB_TOKEN=
# FP_REQUIRE_GITHUB_TOKEN=false
