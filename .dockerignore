# Git files
.git
.gitignore

# Editor files
.vscode
.idea
*.swp
*.swo

# Build artifacts
**/bin
**/obj
**/node_modules
# Built screens are rebuilt inside the image (the web stage), never copied in.
**/dist
**/*.exe
**/*.dll
**/*.so
**/*.dylib

# Logs
**/*.log
**/logs

# Local development files and secrets: pass these at run time, never bake them in
**/.env
**/.env.*
**/*.pem
**/*.zip

# Docker files (to avoid recursive copying)
Dockerfile
docker-compose.yml
.dockerignore

# Database files (these will be mounted as volumes)
**/*.db
**/*.sqlite
**/*.sqlite3

# Other unnecessary files
**/README.md
**/LICENSE
**/.DS_Store
